# Model string: provider:model
# Examples: azure-responses:gpt-6-astra | azure:gpt-4.1-nano | openai:gpt-4.1 | test
# Reasoning models + tools need azure-responses: (chat completions rejects that combo)
CLAW_MODEL=azure-responses:gpt-6-astra

# --- Azure / Microsoft Foundry (Pydantic AI azure: prefix) ---
# Use the OpenAI-compatible v1 endpoint (path must end in /v1/), NOT the /api/projects/... URL.
AZURE_OPENAI_ENDPOINT=https://housemanagement.services.ai.azure.com/api/projects/proj-default
AZURE_OPENAI_API_KEY=
# Optional reference (Foundry project management endpoint)
AZURE_AI_PROJECT_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/api/projects/YOUR_PROJECT

# Other providers (set the one matching CLAW_MODEL)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Workspace for file/shell tools (default: process cwd)
CLAW_WORKSPACE=.

# Optional shared secret for gateway auth. If unset, gateway binds localhost with no auth.
GATEWAY_TOKEN=

# Gateway bind (defaults shown)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=18789

# Session queue mode: followup | steer | collect | interrupt
CLAW_QUEUE_MODE=followup

# Ambient heartbeat (gateway). 0m/off disables; try 30m for OpenClaw-like check-ins.
CLAW_HEARTBEAT=0m
CLAW_HEARTBEAT_SESSION=main

# Multi-channel routing (OpenClaw-shaped)
CLAW_AGENT_ID=main
# DM scope: main | per-peer | per-channel-peer | per-account-channel-peer
CLAW_DM_SCOPE=main
# Group scope: per-group | main
CLAW_GROUP_SCOPE=per-group
# Optional identity links JSON: {"me":["telegram:123","slack:U456"]}
# CLAW_IDENTITY_LINKS=

# SpacetimeDB task/job coordination (optional). When set, cron jobs are claimed
# transactionally so multiple gateways never run the same job.
# CLAW_SPACETIME_URI=http://127.0.0.1:3001
# CLAW_SPACETIME_DB=claw-jobs
# CLAW_SPACETIME_TOKEN=
# CLAW_SPACETIME_WORKER_ID=gateway-1

# Host desktop computer-use (screenshots + pointer/keyboard). Set 0 to disable.
# On macOS, grant Accessibility + Screen Recording to the terminal/Python app.
CLAW_COMPUTER_USE=1

# --- ElevenLabs (shared by two things in this repo) ---
# 1. Node/TypeScript ElevenLabs Agents integration (package.json + src/agent|server/)
# 2. claw's own voice channel (src/claw/channels/voice.py) — raw STT/TTS, not Agents
# Permissions needed on this key: Conversational AI (Read+Write), Speech to Text, Text to Speech.
ELEVENLABS_API_KEY=

# Voice for claw's TTS replies (src/claw/channels/voice.py). Defaults to
# Default voice for claw's STT/TTS voice channel. Find voice IDs at
# https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=0BltqDEeOFspLMBF75TG

# Vapi private API key (dashboard > API Keys). Used by `npm run create-vapi-assistant`
# and `npm run import-phone` (which provisions a free Vapi US number).
VAPI_API_KEY=
# The Vapi number's brain is the claw agent, via the gateway's /vapi/<secret>/chat/completions
# endpoint. Secret: openssl rand -hex 32 (read by both claw and the Node scripts).
VAPI_LLM_SECRET=
# Public https URL of the claw gateway (tunnel to GATEWAY_PORT, e.g. 18789).
CLAW_PUBLIC_URL=
# Optional preferred area code for the Vapi number, e.g. 734
VAPI_AREA_CODE=

# Shared secret ElevenLabs sends back as a request header on every server-tool
# webhook call. Generate with: openssl rand -hex 32
TOOL_WEBHOOK_SECRET=

# HMAC secret shown when registering the post-call webhook in the ElevenLabs
# dashboard (Conversational AI > Settings > Webhooks).
POST_CALL_WEBHOOK_SECRET=

# Publicly reachable base URL for the Node server (ngrok/cloudflared tunnel
# during local dev, or your deployed URL).
WEBHOOK_BASE_URL=http://localhost:3000

PORT=3000

# --- Dashboard connectors ---
# Nessie (Capital One mock bank, https://api.nessieisreal.com/): free key from the
# Nessie portal. Any value works for the demo; with no customers on the account the
# dashboard shows a bundled sample and labels it "mock".
NESSIE_API_KEY=
# NESSIE_BASE_URL=https://api.nessieisreal.com
# FinchNode (https://finchnode.com/) public demo API, synthetic patients, no key needed.
# FINCHNODE_BASE_URL=https://api.finchnode.com/demo/v1
# FINCHNODE_SUBJECT=patient-demo-001
