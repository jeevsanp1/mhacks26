  "narrative": {
    "northStar": "The Station Concourse",
    "overview": "A public concourse works because it is calm, legible and obvious. White and light grey carry about 60% of every screen, charcoal and neutrals about 25%, teal about 10% for the one thing to do next, and status colors the remaining 5%. Type is large, spacing is generous, controls are big and round.",
    "keyCharacteristics": [
      "60 / 25 / 10 / 5 colour ratio.",
      "WCAG 2.2 AAA: 7:1 text, 44px targets, 3px focus rings, never colour alone.",
      "Large, plain type: 18px body, nothing below 16px.",
      "One primary action per view; large pill buttons.",
      "Everything native: real buttons, links, labels, headings, landmarks."
    ],
    "rules": [
      {
        "name": "The Teal Rule",
        "body": "Teal marks the next step. If more than one thing on a screen is teal-filled, none of them is.",
        "section": "colors"
      },
      {
        "name": "The Coral-Is-Errors Rule",
        "body": "Coral is for errors only (SBB reserves red for errors; the rule carries over).",
        "section": "colors"
      },
      {
        "name": "The Words-Beside-Colour Rule",
        "body": "Every status colour is paired with a word. Colour alone never carries meaning.",
        "section": "colors"
      },
      {
        "name": "The Honest Data Rule",
        "body": "Mock and sample data is labelled as such, never in Green.",
        "section": "colors"
      },
      {
        "name": "The Sixteen-Pixel Floor",
        "body": "No text under 1rem.",
        "section": "typography"
      },
      {
        "name": "The Sentence-Case Rule",
        "body": "Sentence case everywhere; no all-caps labels.",
        "section": "typography"
      },
      {
        "name": "The Quiet Lift Rule",
        "body": "Elevation answers an interaction; it is not a resting decoration.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep white and mist at about 60% of any screen and teal at about 10%.",
      "Do use the SBB spacing scale and radius scale, and the tokens in tokens.css.",
      "Do make every tappable target at least 44 x 44px and every text at least 16px.",
      "Do pair every colour signal with a word, shape or underline.",
      "Do use native elements, visible labels, skip links and landmarks.",
      "Do write sentence case, short verb-first button labels, descriptive link text, and errors that say how to fix them.",
      "Do respect prefers-reduced-motion.",
      "Do support light and dark from the same tokens, solved separately for AAA."
    ],
    "donts": [
      "Don't use the SBB logo, signet, icons, pictograms, clock or typeface.",
      "Don't use coral for anything but errors.",
      "Don't use all-caps labels, placeholder-only labels or \"Click here\".",
      "Don't use more than one primary button per view.",
      "Don't rely on hover, drag, multi-touch or long-press as the only way to do something.",
      "Don't use Unicode glyphs or emoji as icons, or decorative shadows and gradients.",
      "Don't use the raw palette teal or tan; use the AAA steps."
    ]
  }
